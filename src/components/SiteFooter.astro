---
import type { NavigationItem } from '../data/home';

interface Props {
  navigation: readonly NavigationItem[];
}

const { navigation } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell site-footer__grid">
    <div class="site-footer__identity">
      <a class="wordmark wordmark--footer" href="/" aria-label="Pro Parking Group home">
        <span class="wordmark__primary">Pro Parking</span>
        <span class="wordmark__secondary">Group</span>
      </a>
      <p>Parking management, systems, and technology for property owners.</p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer navigation">
      <p class="site-footer__label">Navigate</p>
      <ul>
        {navigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__companies">
      <p class="site-footer__label">Our companies</p>
      <p>Professional Parking Management Corporation (Pro-P)</p>
      <p>Park Secure Management Corporation (Park Secure)</p>
    </div>

    <div class="site-footer__contact" id="privacy">
      <p class="site-footer__label">Contact and legal</p>
      <p>Contact details and the Privacy Notice will be published when approved.</p>
    </div>
  </div>

  <div class="shell site-footer__base">
    <p>&copy; {year} Pro Parking Group.</p>
    <p>Pro-P and Park Secure</p>
  </div>
</footer>
