---
import type { NavigationItem } from '../data/home';

interface Props {
  navigation: readonly NavigationItem[];
}

const { navigation } = Astro.props;
---

<header class="site-header" data-site-header>
  <div class="shell site-header__inner">
    <a class="wordmark" href="/" aria-label="Pro Parking Group home">
      <span class="wordmark__primary">Pro Parking</span>
      <span class="wordmark__secondary">Group</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul>
        {navigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <a class="button button--compact header-cta" href="#site-assessment">
      Request a Site Assessment
    </a>

    <details class="mobile-nav" data-mobile-nav>
      <summary>
        <span>Menu</span>
        <span class="mobile-nav__icon" aria-hidden="true"><i></i><i></i></span>
      </summary>
      <div class="mobile-nav__panel">
        <nav aria-label="Mobile navigation">
          <ul>
            {navigation.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="button" href="#site-assessment">Request a Site Assessment</a>
      </div>
    </details>
  </div>
</header>

<script>
  const mobileNavs = document.querySelectorAll<HTMLDetailsElement>('[data-mobile-nav]');

  mobileNavs.forEach((mobileNav) => {
    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => mobileNav.removeAttribute('open'));
    });

    mobileNav.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        mobileNav.removeAttribute('open');
        mobileNav.querySelector('summary')?.focus();
      }
    });
  });
</script>
