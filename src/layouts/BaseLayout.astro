---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import type { NavigationItem } from '../data/home';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  navigation: readonly NavigationItem[];
}

const { title, description, navigation } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const robots = Astro.site ? 'index, follow' : 'noindex, nofollow';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#102b28" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader navigation={navigation} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter navigation={navigation} />
  </body>
</html>
